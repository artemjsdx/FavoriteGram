{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "favouritegram",
  "main": "../dist/server/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "favouritegram-db",
      "database_id": "__D1_DATABASE_ID__"
    }
  ]
}
